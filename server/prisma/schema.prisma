generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  email        String?  @unique
  // True once the owner proved the address: Google, an email confirmation link or a password reset link
  emailVerified Boolean @default(false)
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  sessions         Session[]
  stats            UserStats?
  sentRequests     Friendship[] @relation("FriendRequester")
  receivedRequests Friendship[] @relation("FriendTarget")
  passwordResets    PasswordReset[]
  emailVerifications EmailVerification[]
  gameParticipants  GameParticipant[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserStats {
  id          String @id @default(cuid())
  userId      String @unique
  gamesPlayed Int    @default(0)
  gamesWon    Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  targetId    String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("FriendTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId])
}

model GameHistory {
  id           String   @id @default(cuid())
  roomCode     String
  gameMode     String
  winningTeam  Int
  totalRounds  Int
  scoreTeam0   Int
  scoreTeam1   Int
  playerCount  Int      @default(4)
  startedAt    DateTime
  endedAt      DateTime @default(now())

  participants GameParticipant[]

  @@index([endedAt])
}

model GameParticipant {
  id            String  @id @default(cuid())
  gameHistoryId String
  userId        String?
  playerName    String
  playerIndex   Int
  team          Int
  won           Boolean

  gameHistory GameHistory @relation(fields: [gameHistoryId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([gameHistoryId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // SHA-256 of the emailed token; the raw token is never stored
  email     String?  // Address the link was sent to; a reset only verifies the email if it still matches
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// A pending email address, saved on the User only after the owner clicks the link
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String   @unique // SHA-256 of the emailed token
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}
